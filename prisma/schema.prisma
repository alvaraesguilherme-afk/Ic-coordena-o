// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LIDER
  MEMBRO
}

enum TipoEscala {
  INTERCESSAO
  INTEGRACAO
  MIDIA
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  birthDate    DateTime?
  phone        String?
  address      String?
  avatarUrl    String?
  role         Role                 @default(MEMBRO)
  igrejaId     String?
  igreja       IgrejaCasa?          @relation(fields: [igrejaId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  presencas    Presenca[]
  escalas      EscalaParticipante[]
  avisos       Aviso[]
}

model Reuniao {
  id        String     @id @default(cuid())
  titulo    String
  data      DateTime
  descricao String?
  createdAt DateTime   @default(now())
  presencas Presenca[]
}

model Presenca {
  id        String   @id @default(cuid())
  reuniaoId String
  reuniao   Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presente  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([reuniaoId, userId])
}

model Rede {
  id        String       @id @default(cuid())
  nome      String
  liderNome String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  igrejas   IgrejaCasa[]
}

model IgrejaCasa {
  id        String    @id @default(cuid())
  nome      String
  endereco  String?
  liderNome String
  diaSemana DiaSemana
  horario   String
  redeId    String
  rede      Rede      @relation(fields: [redeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  membros   User[]
}

model Escala {
  id            String               @id @default(cuid())
  tipo          TipoEscala
  data          DateTime
  observacao    String?
  createdAt     DateTime             @default(now())
  participantes EscalaParticipante[]
}

model EscalaParticipante {
  id        String   @id @default(cuid())
  escalaId  String
  escala    Escala   @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([escalaId, userId])
}

model Aviso {
  id        String   @id @default(cuid())
  titulo    String
  conteudo  String
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
