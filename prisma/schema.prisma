// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LIDER
  MEMBRO
  PASTOR
}

enum TipoEscala {
  INTERCESSAO
  INTEGRACAO
  MIDIA
}

enum ServoMidiaStatus {
  NENHUM
  PENDENTE
  APROVADO
}

// Postos da grade mensal — Câmera 1 e Câmera 2 são dois postos físicos distintos
enum AreaMidia {
  PROJECAO
  ILUMINACAO
  STORIES
  CAMERA_1
  CAMERA_2
  TRANSMISSAO
  FOTOGRAFIA
}

// Funções dos servos — "Câmera" é uma função só; a pessoa pode operar em
// qualquer um dos dois postos de câmera na hora de montar a grade
enum FuncaoMidia {
  PROJECAO
  ILUMINACAO
  STORIES
  CAMERA
  TRANSMISSAO
  FOTOGRAFIA
}

enum NivelMidia {
  TREINEIRO
  VETERANO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum CategoriaLink {
  DRIVES_ESCOLA_IMPULSE
  MINISTRACOES
  EVENTOS
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String
  birthDate    DateTime?
  phone        String?
  address      String?
  avatarUrl    String?
  role         Role                 @default(MEMBRO)
  notificacoes Boolean              @default(true)
  onboardingCompleto Boolean        @default(false)
  isAdmin      Boolean              @default(false)
  ocultoDeMembros Boolean           @default(false)
  sessionId        String?
  sessionExpiresAt DateTime?
  servoMidiaStatus ServoMidiaStatus @default(NENHUM)
  servoMidiaSolicitadoEm DateTime?
  servoMidiaRecusadoEm DateTime?
  areaSolicitadaMidia FuncaoMidia?
  supervisorMidia  Boolean          @default(false)
  supervisorIntegracao  Boolean     @default(false)
  supervisorIntercessao Boolean     @default(false)
  areasServoMidia  AreaMidiaServo[]
  igrejaId     String?
  igreja       IgrejaCasa?          @relation(fields: [igrejaId], references: [id], onDelete: SetNull)
  redeId       String?
  rede         Rede?                @relation(fields: [redeId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  presencas    Presenca[]
  escalas      EscalaParticipante[]
  avisos       Aviso[]
  linksUteis   LinkUtil[]
  playlists    Playlist[]
  icsLideradas IgrejaCasa[]         @relation("IgrejaLider")
  midiaEscalado  EscalaMidiaEntrada[] @relation("MidiaEscalado")
  midiaTreinando EscalaMidiaEntrada[] @relation("MidiaTreinando")
  pushSubscriptions PushSubscription[]
  escalasIcLideradas EscalaIcEntrada[]
  relatoriosIcEnviados RelatorioEscalaIc[]
  permutasSolicitadas PermutaMidia[] @relation("PermutaSolicitante")
  permutasAceitas     PermutaMidia[] @relation("PermutaAceitoPor")

  @@index([redeId])
  @@index([igrejaId])
}

model AreaMidiaServo {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   FuncaoMidia
  nivel  NivelMidia  @default(TREINEIRO)

  @@unique([userId, area])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Reuniao {
  id        String     @id @default(cuid())
  igrejaId  String
  igreja    IgrejaCasa @relation(fields: [igrejaId], references: [id], onDelete: Cascade)
  data      DateTime
  createdAt DateTime   @default(now())
  presencas Presenca[]

  @@unique([igrejaId, data])
  @@index([igrejaId])
}

model Presenca {
  id        String   @id @default(cuid())
  reuniaoId String
  reuniao   Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presente  Boolean  @default(false)
  motivo    String?
  createdAt DateTime @default(now())

  @@unique([reuniaoId, userId])
}

model Rede {
  id        String       @id @default(cuid())
  nome      String
  liderNome String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  igrejas   IgrejaCasa[]
  usuarios  User[]
  eventos   Evento[]
}

model Evento {
  id        String   @id @default(cuid())
  titulo    String
  data      DateTime
  redeId    String
  rede      Rede     @relation(fields: [redeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([redeId, data])
}

model IgrejaCasa {
  id        String    @id @default(cuid())
  nome      String
  endereco  String?
  liderId   String?
  lider     User?     @relation("IgrejaLider", fields: [liderId], references: [id], onDelete: SetNull)
  diaSemana DiaSemana
  horario   String
  redeId    String
  rede      Rede      @relation(fields: [redeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  membros   User[]
  reunioes  Reuniao[]

  @@index([redeId])
  @@index([liderId])
}

model Escala {
  id            String               @id @default(cuid())
  tipo          TipoEscala
  data          DateTime
  observacao    String?
  createdAt     DateTime             @default(now())
  participantes EscalaParticipante[]

  @@index([data])
}

model EscalaParticipante {
  id        String   @id @default(cuid())
  escalaId  String
  escala    Escala   @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([escalaId, userId])
  @@index([userId])
}

// Marca que o supervisor concluiu a grade de um mês — servos comuns só
// enxergam a grade (quem está escalado onde) depois que esse registro existe;
// antes disso, enquanto o supervisor ainda está montando, veem só um aviso.
model GradeMidiaMes {
  id          String   @id @default(cuid())
  ano         Int
  mes         Int
  concluidaEm DateTime @default(now())

  @@unique([ano, mes])
}

model EscalaMidiaEntrada {
  id          String    @id @default(cuid())
  area        AreaMidia
  data        DateTime
  escaladoId  String
  escalado    User      @relation("MidiaEscalado", fields: [escaladoId], references: [id], onDelete: Cascade)
  treinandoId String?
  treinando   User?     @relation("MidiaTreinando", fields: [treinandoId], references: [id], onDelete: SetNull)
  escaladoPresente     Boolean?
  escaladoMotivoFalta  String?
  treinandoPresente    Boolean?
  treinandoMotivoFalta String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  permutas    PermutaMidia[]

  @@unique([area, data])
  @@index([escaladoId])
  @@index([treinandoId])
  @@index([data])
}

enum PermutaMidiaStatus {
  ABERTA
  ACEITA
  CANCELADA
}

// Pedido de cobertura pra um compromisso da grade de mídia — o escalado fica
// indisponível, abre a permuta, e o primeiro veterano da mesma função que
// aceitar assume o lugar dele (EscalaMidiaEntrada.escaladoId é trocado na hora).
model PermutaMidia {
  id            String              @id @default(cuid())
  entradaId     String
  entrada       EscalaMidiaEntrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  solicitanteId String
  solicitante   User                @relation("PermutaSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  status        PermutaMidiaStatus  @default(ABERTA)
  aceitoPorId   String?
  aceitoPor     User?               @relation("PermutaAceitoPor", fields: [aceitoPorId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  respondidoEm  DateTime?

  @@index([entradaId])
  @@index([status])
  @@index([solicitanteId])
}

// Escala de Integração/Intercessão: 2 ICs (via seus líderes) por sábado.
model EscalaIcEntrada {
  id        String     @id @default(cuid())
  tipo      TipoEscala
  data      DateTime
  vaga      Int
  liderId   String
  lider     User       @relation(fields: [liderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([tipo, data, vaga])
  @@index([liderId])
  @@index([data])
}

// Relatório de culto preenchido pelos dois líderes escalados naquele dia (só
// eles têm acesso, ver campoSupervisorIc/entradas em EscalaIcEntrada) — uma
// linha por (tipo, data), travada pra sempre depois de criada (nunca é feito
// update, só create; ver enviarRelatorioIc em src/app/actions/relatorio-ic.ts).
model RelatorioEscalaIc {
  id               String     @id @default(cuid())
  tipo             TipoEscala
  data             DateTime
  visitantes       Int
  presentes        Int
  novosConvertidos Int
  enviadoPorId     String
  enviadoPor       User       @relation(fields: [enviadoPorId], references: [id], onDelete: Cascade)
  createdAt        DateTime   @default(now())

  @@unique([tipo, data])
  @@index([enviadoPorId])
}

model Aviso {
  id         String    @id @default(cuid())
  titulo     String
  conteudo   String
  dataEvento DateTime?
  local      String?
  autorId    String
  autor      User      @relation(fields: [autorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model LinkUtil {
  id        String        @id @default(cuid())
  titulo    String
  url       String
  capaUrl   String?
  categoria CategoriaLink
  autorId   String
  autor     User          @relation(fields: [autorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([categoria])
}

model Playlist {
  id        String   @id @default(cuid())
  titulo    String
  url       String
  capaUrl   String
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
